generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// El módulo se guarda como texto simple (no enum) por consistencia con
// el resto del proyecto; se valida en el código de la aplicación (ver
// backend/src/lib/constants.js). Valores válidos:
// "PALABRAS" | "COMPRENSION" | "FLUIDEZ" | "ORTOGRAFIA"

model Estudiante {
  id                String    @id @default(cuid())
  nombre            String
  usuario           String    @unique
  passwordHash      String
  curso             String
  puntos            Int       @default(0)
  racha             Int       @default(0)
  ultimaActividadEn DateTime?
  createdAt         DateTime  @default(now())

  intentos Intento[]
  logros   EstudianteLogro[]

  // El panel del docente y el ranking filtran por curso en cada carga.
  @@index([curso])
}

model Docente {
  id           String   @id @default(cuid())
  nombre       String
  usuario      String   @unique
  passwordHash String
  // JSON-string con el arreglo de cursos asignados, ej. '["6°","7°"]'
  // (mismo patrón que Actividad.contenido / Logro.criterio). Un docente
  // solo ve estudiantes de estos cursos; un administrador ve todos.
  cursosAsignados String   @default("[]")
  createdAt    DateTime @default(now())
}

// Rol separado del docente: administra cuentas de estudiantes/docentes
// desde el panel /admin, sin acceso al panel de seguimiento por sí solo
// (aunque también puede verlo, ver requireRole en las rutas de docente).
model Administrador {
  id           String   @id @default(cuid())
  nombre       String
  usuario      String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Actividad {
  id         String   @id @default(cuid())
  modulo     String
  // Grado al que está dirigida esta actividad (ver CURSOS en
  // backend/src/lib/constants.js). Cada estudiante solo ve las
  // actividades de su propio curso.
  curso      String
  titulo     String
  // Estructura de "contenido" por módulo (JSON serializado como texto):
  //  PALABRAS:    { instruccion, opciones: [string], respuesta: string }
  //  COMPRENSION: { texto, pregunta, opciones: [string], respuesta: number }
  //  FLUIDEZ:     { texto, palabras: number, ppmObjetivo: number }
  //  ORTOGRAFIA:  { instruccion, opciones: [string], respuesta: string, foco }
  //               (foco: ver backend/src/lib/focosOrtografia.js)
  contenido  String
  orden      Int
  puntosBase Int      @default(20)
  createdAt  DateTime @default(now())

  intentos Intento[]

  @@unique([modulo, curso, orden])
}

model Intento {
  id             String    @id @default(cuid())
  estudianteId   String
  actividadId    String
  correcto       Boolean
  puntosGanados  Int       @default(0)
  // Metadata opcional específica del módulo (ej. tiempoSegundos/ppm en Fluidez)
  metadata       String?
  creadoEn       DateTime  @default(now())

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  actividad  Actividad  @relation(fields: [actividadId], references: [id])

  @@index([estudianteId])
  @@index([actividadId])
}

model Logro {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  icono       String
  descripcion String
  criterio    String
  createdAt   DateTime @default(now())

  estudiantes EstudianteLogro[]
}

model EstudianteLogro {
  estudianteId String
  logroId      String
  conseguidoEn DateTime @default(now())

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  logro      Logro      @relation(fields: [logroId], references: [id])

  @@id([estudianteId, logroId])
}

// Actividad generada por la IA a partir de los documentos subidos (y del
// estudio pedagógico), pendiente de revisión de un docente/administrador
// antes de publicarse a los estudiantes. Solo si se aprueba se crea la
// Actividad real; el docente también puede pedir que se regenere dando
// una sugerencia de mejora, o rechazarla.
model PropuestaActividad {
  id                String   @id @default(cuid())
  modulo            String
  curso             String
  titulo            String
  contenido         String // mismo formato que Actividad.contenido, incluye "explicacion"
  estado            String   @default("pendiente") // "pendiente" | "aprobada" | "rechazada"
  basadaEnDocumentos Boolean @default(false)
  sugerenciaDocente String? // última sugerencia dada para regenerar, o motivo de rechazo
  creadaPor         String // nombre del docente/admin que pidió la generación
  actividadId       String? // id de la Actividad publicada, una vez aprobada
  createdAt         DateTime @default(now())
  actualizadaEn     DateTime @updatedAt
}

// Documentos de apoyo que suben docentes/administradores. El texto se
// extrae al subir el archivo y se usa como contexto del asistente IA
// (RAG) — así no hay que re-procesar el archivo en cada consulta.
// Por defecto son privados del cuerpo docente; el que quiera entregarse
// como refuerzo a los estudiantes se marca con visibleParaEstudiantes.
model Documento {
  id            String   @id @default(cuid())
  nombre        String // nombre original del archivo
  archivo       String // nombre del archivo en disco (uploads/)
  mimeType      String
  tamano        Int // bytes
  descripcion   String?
  // Material de refuerzo: si es true, los estudiantes lo ven y lo pueden
  // descargar desde su panel. Arranca en false a propósito — subir un
  // archivo no debe publicarlo por accidente (hay guías y rúbricas que
  // solo son del docente).
  visibleParaEstudiantes Boolean @default(false)
  // JSON-string con los cursos que lo ven, ej. '["6°","7°"]' (mismo
  // patrón que Docente.cursosAsignados). Arreglo vacío = todos los cursos.
  cursos        String   @default("[]")
  // Texto extraído del archivo (PDF/Word/texto plano) para el asistente
  // IA; null si el formato no permitió extraer texto.
  textoExtraido String?
  subidoPor     String // nombre del docente/admin que lo subió
  createdAt     DateTime @default(now())
}
