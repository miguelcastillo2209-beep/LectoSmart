# Local (SQLite, por defecto):
DATABASE_URL="file:./dev.db"
# Nube (Postgres) — requiere cambiar provider a "postgresql" en
# prisma/schema.prisma y regenerar las migraciones:
# DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
PORT=4000

# Cuenta de administrador que crea el seed. Si no se definen, se usa
# admin/R0CK3T (solo pensado para desarrollo local).
# IMPORTANTE: deben coincidir siempre con la cuenta de administrador real.
# El seed busca por `usuario`; si la cuenta se renombra en la base de datos
# y aquí queda el nombre viejo, el siguiente reseed no la encuentra y crea
# una cuenta ADICIONAL con la contraseña por defecto — una puerta trasera.
ADMIN_USUARIO="admin"
ADMIN_PASSWORD="cambia-esta-contraseña"

# URL del frontend desplegado, para restringir CORS en producción.
# En desarrollo local se puede dejar vacía/sin definir.
FRONTEND_URL=""
